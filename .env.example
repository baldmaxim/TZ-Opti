# Корневой .env.example
# Сервер
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200

# Supabase Postgres. В дашборде Supabase: Project → Connect → "URI".
# Замените <password> на реальный пароль БД (URL-encode спецсимволы).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# БД для тестов задаётся ОТДЕЛЬНО — в .env.test (шаблон .env.test.example).
# Тестовый процесс DATABASE_URL не использует вообще, см. docs/development.md.

# Очередь фоновых задач (analysis_jobs / analysis_tasks в Postgres, без Redis).
# WORKER_MODE=embedded (дефолт) — воркер поднимается внутри процесса сервера,
#   как было раньше: «запустил npm run dev — анализ работает».
# WORKER_MODE=external — сервер только отдаёт API, очередь разбирают отдельные
#   процессы: npm run worker (можно несколько, в т.ч. на другой машине).
WORKER_MODE=embedded
# Сколько задач воркер тянет одновременно. Стадии — тяжёлые LLM-прогоны,
# параллель им вредит (см. STAGE1_CONCURRENCY ниже) — держите 1.
WORKER_CONCURRENCY=1
# Аренда задачи и её продление. Если воркер не продлил аренду за WORKER_LEASE_MS
# (упал, убит, потерял сеть) — задача считается осиротевшей: её вернут в очередь
# (продолжится с чекпойнта) либо пометят interrupted, когда попытки исчерпаны.
WORKER_LEASE_MS=60000
WORKER_HEARTBEAT_MS=15000
# Пауза опроса пустой очереди и период проверки осиротевших задач.
WORKER_POLL_MS=2000
WORKER_REAP_MS=30000

# OpenAI (Стадия 1 ИИ-агента; обязателен для запуска анализа стадии 1)
# Ключ — секрет, в репозиторий не коммитится. ТЗ улетает в OpenAI — должно быть согласовано с командой.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL — опционально, для прокси/совместимых эндпоинтов. По умолчанию api.openai.com.
OPENAI_BASE_URL=
# Режим системного промта Стадии 1: structural (дефолт) | strict | full.
# Подробности и доп. тюнинг (BRIDGE_*, STAGE1_VOR_MAX_CHARS) —
# server/devtools/README.md.
STAGE1_PROMPT_VARIANT=structural
# Режим промта Стадии 2 (Q&A + характеристики), Стадии 3 (существенные условия
# компании), Стадии 4 (типовые риски) и Стадии 5 (самоанализ ТЗ):
# structural (дефолт) | strict | full.
STAGE2_PROMPT_VARIANT=structural
STAGE3_PROMPT_VARIANT=structural
STAGE4_PROMPT_VARIANT=structural
STAGE5_PROMPT_VARIANT=structural
# Иерархическая token-aware сегментация ТЗ (общая для стадий 1–5).
# STAGE_SEGMENT_TOKENS — ПОТОЛОК ОДНОЙ ЧАСТИ ТЗ в токенах. Символьные бюджеты
# ниже отвечают на вопрос «что влезет в контекст», этот — «что модель реально
# прочитает, не потеряв середину». Деление идёт по разделам и пунктам, соседние
# части перекрываются (пункт на стыке читается целиком), слишком большой пункт
# дробится отдельно. Меньше значение → больше частей, дороже прогон, но
# внимательнее разбор.
STAGE_SEGMENT_TOKENS=20000
# Уровень заголовка, по которому предпочтительно начинать новую часть (1 = только
# разделы верхнего уровня, 2 — ещё и подразделы).
STAGE_SEGMENT_SECTION_LEVEL=2
# Финальная межраздельная сверка после прогона всех частей: снимает повторы со
# стыков и ищет связи/противоречия между разделами. 0 — выключить (останется
# только детерминированный дедуп). STAGE_CROSS_SEGMENT_MAX — сколько находок
# уходит в сверку (самые критичные; остальные не теряются, но в шаг не идут).
STAGE_CROSS_SEGMENT_REVIEW=1
STAGE_CROSS_SEGMENT_MAX=200
# Отдельный потолок части для QC-прогона Стадии 5 (по умолчанию = STAGE_SEGMENT_TOKENS).
# Легаси STAGE5_TZ_BUDGET (в символах) больше НЕ усекает ТЗ — он лишь
# пересчитывается в токенный бюджет части.
STAGE5_SEGMENT_TOKENS=20000
# Стадия 1: размер сегмента и одновременность. ПРОВЕРЕНО — подписка Claude
# Code не держит параллель (троттлинг/таймауты), дефолт CONCURRENCY=1.
# >1 имеет смысл только на платном прямом API.
STAGE1_CHAR_BUDGET=140000
STAGE1_CONCURRENCY=1
# ВАЖНО (2026-06-02): extended thinking на крупном промпте Стадии 1 виснет
# >15 мин и не отдаёт ничего → стадия падает с пустым ответом. Отключение
# thinking — РАБОЧИЙ фикс (тот же вход → 121 находка за ~12 мин). Держать 1.
STAGE1_FAST_THINKING=1
# Нативный structured-output (outputFormat) Agent SDK тоже виснет на схеме-
# массиве находок. 1 → бридж сразу отдаёт свободный JSON (валидируется ajv по
# той же строгой схеме). См. project-stage1-context-limit / claudeBridge.js.
BRIDGE_SKIP_OUTPUT_FORMAT=1
# Короткий таймаут (мс) на попытку outputFormat, затем фолбэк в свободный JSON
# (раньше тут был fail-fast, убивавший рабочий фолбэк).
BRIDGE_OUTPUTFORMAT_TIMEOUT_MS=180000

# Клиент
VITE_API_BASE=/api
