{
  "name": "tz-opti-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "purge": "node scripts/purgeHistory.js",
    "benchmark": "node scripts/runBenchmark.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --env-file=test/env/test.env --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --env-file=test/env/test.env --env-file-if-exists=../.env.test --test \"test/integration/**/*.test.js\"",
    "test:integration:strict": "node --env-file=test/env/test.env --env-file=test/env/strict.env --env-file-if-exists=../.env.test --test \"test/integration/**/*.test.js\"",
    "test:acceptance": "node --env-file=test/env/test.env --env-file-if-exists=../.env.test --test --test-concurrency=1 \"test/acceptance/**/*.test.js\"",
    "check:syntax": "node scripts/checkSyntax.js",
    "ci:unit": "node scripts/runTests.js test/unit --strict",
    "ci:integration": "node scripts/runTests.js test/integration --strict --env=../.env.test",
    "ci:acceptance": "node scripts/runTests.js test/acceptance --strict --concurrency=1 --env=../.env.test",
    "ci:migrate:empty": "node scripts/ciMigrationCheck.js --empty",
    "ci:migrate:populated": "node scripts/ciMigrationCheck.js --populated"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.142",
    "@xmldom/xmldom": "^0.9.3",
    "ajv": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "jsonrepair": "^3.14.0",
    "mammoth": "^1.8.0",
    "mdast-util-to-string": "^4.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "pizzip": "^3.1.7",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "xpath": "^0.0.34"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
