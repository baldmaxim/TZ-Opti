# Корневой .env.example
# Сервер
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200

# Supabase Postgres. В дашборде Supabase: Project → Connect → "URI".
# Замените <password> на реальный пароль БД (URL-encode спецсимволы).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# БД для тестов задаётся ОТДЕЛЬНО — в .env.test (шаблон .env.test.example).
# Тестовый процесс DATABASE_URL не использует вообще, см. docs/development.md.

# Очередь фоновых задач (analysis_jobs / analysis_tasks в Postgres, без Redis).
# WORKER_MODE=embedded (дефолт) — воркер поднимается внутри процесса сервера,
#   как было раньше: «запустил npm run dev — анализ работает».
# WORKER_MODE=external — сервер только отдаёт API, очередь разбирают отдельные
#   процессы: npm run worker (можно несколько, в т.ч. на другой машине).
WORKER_MODE=embedded
# Сколько задач воркер тянет одновременно. Стадии — тяжёлые LLM-прогоны,
# параллель им вредит (см. STAGE1_CONCURRENCY ниже) — держите 1.
WORKER_CONCURRENCY=1
# Аренда задачи и её продление. Если воркер не продлил аренду за WORKER_LEASE_MS
# (упал, убит, потерял сеть) — задача считается осиротевшей: её вернут в очередь
# (продолжится с чекпойнта) либо пометят interrupted, когда попытки исчерпаны.
WORKER_LEASE_MS=60000
WORKER_HEARTBEAT_MS=15000
# Пауза опроса пустой очереди и период проверки осиротевших задач.
WORKER_POLL_MS=2000
WORKER_REAP_MS=30000

# OpenAI (Стадия 1 ИИ-агента; обязателен для запуска анализа стадии 1)
# Ключ — секрет, в репозиторий не коммитится. ТЗ улетает в OpenAI — должно быть согласовано с командой.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL — опционально, для прокси/совместимых эндпоинтов. По умолчанию api.openai.com.
OPENAI_BASE_URL=
# Режим системного промта Стадии 1: structural (дефолт) | strict | full.
# Подробности и доп. тюнинг (BRIDGE_*, STAGE1_VOR_*) —
# server/devtools/README.md.
STAGE1_PROMPT_VARIANT=structural
# Режим промта Стадии 2 (Q&A + характеристики), Стадии 3 (существенные условия
# компании), Стадии 4 (типовые риски) и Стадии 5 (самоанализ ТЗ):
# structural (дефолт) | strict | full.
STAGE2_PROMPT_VARIANT=structural
STAGE3_PROMPT_VARIANT=structural
STAGE4_PROMPT_VARIANT=structural
STAGE5_PROMPT_VARIANT=structural
# Иерархическая token-aware сегментация ТЗ (общая для стадий 1–5).
# STAGE_SEGMENT_TOKENS — ПОТОЛОК ОДНОЙ ЧАСТИ ТЗ в токенах. Символьные бюджеты
# ниже отвечают на вопрос «что влезет в контекст», этот — «что модель реально
# прочитает, не потеряв середину». Деление идёт по разделам и пунктам, соседние
# части перекрываются (пункт на стыке читается целиком), слишком большой пункт
# дробится отдельно. Меньше значение → больше частей, дороже прогон, но
# внимательнее разбор.
STAGE_SEGMENT_TOKENS=20000
# Уровень заголовка, по которому предпочтительно начинать новую часть (1 = только
# разделы верхнего уровня, 2 — ещё и подразделы).
STAGE_SEGMENT_SECTION_LEVEL=2
# Финальная межраздельная сверка после прогона всех частей: снимает повторы со
# стыков и ищет связи/противоречия между разделами. 0 — выключить (останется
# только детерминированный дедуп). STAGE_CROSS_SEGMENT_MAX — сколько находок
# уходит в сверку (самые критичные; остальные не теряются, но в шаг не идут).
STAGE_CROSS_SEGMENT_REVIEW=1
STAGE_CROSS_SEGMENT_MAX=200
# Отдельный потолок части для QC-прогона Стадии 5 (по умолчанию = STAGE_SEGMENT_TOKENS).
# Легаси STAGE5_TZ_BUDGET (в символах) больше НЕ усекает ТЗ — он лишь
# пересчитывается в токенный бюджет части.
STAGE5_SEGMENT_TOKENS=20000
# Стадия 1: размер сегмента и одновременность. ПРОВЕРЕНО — подписка Claude
# Code не держит параллель (троттлинг/таймауты), дефолт CONCURRENCY=1.
# >1 имеет смысл только на платном прямом API.
STAGE1_CHAR_BUDGET=140000
STAGE1_CONCURRENCY=1
# ВОР Стадии 1 (структурный импорт, services/vor). Ведомость больше НЕ
# выбрасывается по лимиту символов: под каждую часть ТЗ отбираются релевантные
# позиции, а если и они не влезают — ВОР показывается ПАКЕТАМИ (несколько
# проходов на часть ТЗ), и «работы нет в ВОР» засчитывается только по
# пересечению всех пакетов.
# STAGE1_VOR_BATCH_TOKENS — размер одного пакета ведомости в токенах.
# STAGE1_VOR_MAX_BATCHES — предел пакетов на одну часть ТЗ (проходы
# перемножаются с частями ТЗ; превышение честно помечается в отчёте стадии).
STAGE1_VOR_BATCH_TOKENS=6000
STAGE1_VOR_MAX_BATCHES=4
# ВАЖНО (2026-06-02): extended thinking на крупном промпте Стадии 1 виснет
# >15 мин и не отдаёт ничего → стадия падает с пустым ответом. Отключение
# thinking — РАБОЧИЙ фикс (тот же вход → 121 находка за ~12 мин). Держать 1.
STAGE1_FAST_THINKING=1
# Нативный structured-output (outputFormat) Agent SDK тоже виснет на схеме-
# массиве находок. 1 → бридж сразу отдаёт свободный JSON (валидируется ajv по
# той же строгой схеме). См. project-stage1-context-limit / claudeBridge.js.
BRIDGE_SKIP_OUTPUT_FORMAT=1
# Короткий таймаут (мс) на попытку outputFormat, затем фолбэк в свободный JSON
# (раньше тут был fail-fast, убивавший рабочий фолбэк).
BRIDGE_OUTPUTFORMAT_TIMEOUT_MS=180000

# Клиент
VITE_API_BASE=/api

# ============================================================================
# БЕЗОПАСНОСТЬ (production baseline). Полное описание — docs/security.md.
# В production сервер ПРОВЕРЯЕТ этот блок на старте и отказывается запускаться
# при небезопасной конфигурации (server.js → assertProductionSecurity).
# ============================================================================

# --- Аутентификация: OIDC/JWT без привязки к провайдеру ---------------------
# Режим определяется тем, ЧТО задано (AUTH_MODE нужен, только чтобы переопределить):
#   AUTH_OIDC_ISSUER      → oidc       — discovery + JWKS (Keycloak, Entra ID, Auth0, Google…)
#   AUTH_JWKS_URI         → jwks       — провайдер без discovery
#   AUTH_JWT_PUBLIC_KEY   → public_key — статический ключ (PEM, JWK или JWKS-документ)
#   AUTH_JWT_HS_SECRET    → secret     — общий секрет HS256 (только для простых стендов)
AUTH_MODE=
AUTH_OIDC_ISSUER=
AUTH_JWKS_URI=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_PUBLIC_KEY_FILE=
AUTH_JWT_HS_SECRET=
# Кому выписан токен. В production ОБЯЗАТЕЛЕН: без него сервер примет токен,
# выданный тем же провайдером для другого сервиса.
AUTH_JWT_AUDIENCE=tz-opti-api
# Разрешённые алгоритмы подписи. По умолчанию только асимметричные
# (RS*/PS*/ES*) — HS* рядом с ними это классическая alg-confusion атака.
AUTH_JWT_ALGORITHMS=
AUTH_CLOCK_SKEW_SEC=60
AUTH_JWKS_CACHE_SEC=600
AUTH_JWKS_MIN_REFETCH_SEC=30
AUTH_JWKS_TIMEOUT_MS=5000

# --- Клеймы и роли ----------------------------------------------------------
# Откуда берутся тенант, роли, почта. Поддерживается вложенный путь
# (realm_access.roles) и клейм с URL-подобным именем (https://tz-opti/tenant).
AUTH_CLAIM_TENANT=tenant_id
AUTH_CLAIM_ROLES=realm_access.roles
AUTH_CLAIM_EMAIL=email
AUTH_CLAIM_NAME=name
# Отображение групп/ролей провайдера в роли портала:
#   viewer | engineer | lead | manager | admin
# Всё, что не отобразилось в известную роль, прав НЕ ДАЁТ.
AUTH_ROLE_MAP=
# Роли по умолчанию, если провайдер их не отдаёт (обычно пусто).
AUTH_DEFAULT_ROLES=

# --- Dev-bypass: обход аутентификации ТОЛЬКО в development -------------------
# AUTH_DEV_BYPASS=1 в production — ОШИБКА СТАРТА, а не игнорируемая настройка.
AUTH_DEV_BYPASS=0
AUTH_DEV_SUBJECT=dev-user
AUTH_DEV_TENANT=default
AUTH_DEV_ROLES=admin
AUTH_DEV_EMAIL=dev@localhost

# --- Тенанты ----------------------------------------------------------------
# Тенант, в который миграция переносит существующие тендеры.
SECURITY_DEFAULT_TENANT=default

# --- CORS -------------------------------------------------------------------
# Список разрешённых источников через запятую. В production ОБЯЗАТЕЛЕН,
# «*» запрещена. Вне production пусто = localhost:5173 (Vite).
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=0
CORS_MAX_AGE_SEC=600

# --- Ограничение частоты (счётчики в памяти процесса) -----------------------
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_FAIL_MAX=20
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_ANALYSIS_MAX=30
RATE_LIMIT_EXPORT_MAX=60
# Сколько последних звеньев X-Forwarded-For принадлежат вашей инфраструктуре.
# 0 = заголовок игнорируется целиком (адрес берётся из сокета).
RATE_LIMIT_TRUST_PROXY_HOPS=0

# --- Заголовки и ошибки -----------------------------------------------------
SECURITY_HSTS_ENABLED=1
SECURITY_HSTS_MAX_AGE_SEC=15552000
# 1 — в ответе видны внутренние детали и стек (по умолчанию вне production).
# В production обязано быть 0.
ERRORS_EXPOSE_INTERNALS=

# --- Журнал аудита ----------------------------------------------------------
AUDIT_ENABLED=1
# 0 — успешные ЧТЕНИЯ не пишутся (отказы пишутся всегда).
AUDIT_LOG_READS=1
AUDIT_RETENTION_DAYS=365

# --- Загрузка файлов --------------------------------------------------------
# Список форматов можно только СУЗИТЬ (по умолчанию: docx,xlsx,doc,xls,pdf,md,txt,csv).
UPLOAD_ALLOWED_EXTENSIONS=
# Антивирус ОБЯЗАТЕЛЕН в production: clamd | command | http.
# disabled допустим только вне production.
AV_SCAN_MODE=disabled
AV_CLAMD_HOST=127.0.0.1
AV_CLAMD_PORT=3310
# AV_COMMAND — путь к сканеру КАК ЕСТЬ (пробелы допустимы), аргументы отдельно.
AV_COMMAND=
AV_COMMAND_ARGS=
AV_HTTP_URL=
AV_TIMEOUT_MS=30000
AV_MAX_MB=

# --- TLS до PostgreSQL ------------------------------------------------------
# В production сертификат проверяется ВСЕГДА (sslmode=disable/no-verify —
# ошибка). Корневой сертификат managed-кластера — одним из двух способов:
PGSSLROOTCERT=
DATABASE_CA_CERT=
# Флаг существует только чтобы явно сломать старт, если его включили в production.
DATABASE_ALLOW_INSECURE_TLS=0

# --- Клиент -----------------------------------------------------------------
# Токен для локальной разработки, когда dev-bypass выключен (иначе пусто).
VITE_AUTH_TOKEN=
