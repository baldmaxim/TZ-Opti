# Окружение тестового процесса (грузится через `node --env-file`).
# NODE_ENV=test включает fail-closed защиты: подключение к БД только по
# TEST_DATABASE_URL, реальный LLM запрещён (см. utils/runtimeMode.js).
# Внимание: --env-file в Node НЕ перезаписывает уже заданные переменные —
# второй, неотключаемый сигнал тестового процесса даёт сам `node --test`
# (NODE_TEST_CONTEXT).
NODE_ENV=test
