# Окружение integration-тестов. Скопируйте в .env.test (в git не коммитится).
#
# ВНИМАНИЕ: указывайте ОТДЕЛЬНУЮ тестовую базу — тесты применяют к ней схему
# (runMigration). Совпадение с production DATABASE_URL запрещено: подключение
# будет отклонено с ошибкой TEST_DATABASE_URL_EQUALS_PRODUCTION.
#
# Локальный кластер (см. docs/development.md) — TLS выключается только явно:
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/tz_opti_test?sslmode=disable

# Managed-Postgres (Supabase и т.п.) — TLS включён по умолчанию:
# TEST_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/tz_opti_test
