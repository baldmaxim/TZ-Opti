{
  "name": "tz-opti",
  "version": "0.1.0",
  "private": true,
  "description": "MVP-портал для оптимизации работы инженера тендерного отдела по анализу ТЗ на СМР",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n server,client,bridge -c blue,green,magenta \"npm --prefix server run dev\" \"npm --prefix client run dev\" \"npm run bridge\"",
    "dev:server": "npm --prefix server run dev",
    "worker": "npm --prefix server run worker",
    "dev:client": "npm --prefix client run dev",
    "bridge": "node server/devtools/claudeBridge.js",
    "seed": "npm --prefix server run seed",
    "purge": "npm --prefix server run purge --",
    "benchmark": "npm --prefix server run benchmark --",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server run test",
    "test:unit": "npm --prefix server run test:unit",
    "test:integration": "npm --prefix server run test:integration",
    "test:acceptance": "npm --prefix server run test:acceptance",
    "verify": "npm run test:unit && npm run test:integration && npm run build",
    "verify:integration": "npm --prefix server run test:integration:strict",
    "check:syntax": "npm --prefix server run check:syntax",
    "ci:unit": "npm --prefix server run ci:unit",
    "ci:integration": "npm --prefix server run ci:integration",
    "ci:acceptance": "npm --prefix server run ci:acceptance",
    "ci:migrate:empty": "npm --prefix server run ci:migrate:empty",
    "ci:migrate:populated": "npm --prefix server run ci:migrate:populated"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
